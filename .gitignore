# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.env

# ── Jupyter ───────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Datasets (too large for GitHub) ───────────────────────────
data/raw/
data/processed/
trashcan-1-0/
trashcan_instance/

# ── Model weights (ignore intermediate runs, track core checkpoints <6MB) ──
*.pt
*.pth
*.onnx
*.engine
*.safetensors
*.tflite
!models/final/*.pt
!models/trained/yolo11n.pt
!app/best.pt

# ── Training runs / Ultralytics outputs ───────────────────────
runs/
wandb/
mlruns/

# ── Experiment weights (keep logs/plots, exclude weights) ─────
experiments/*/weights/
experiments/*/predictions/

# ── Large archives ────────────────────────────────────────────
*.zip

# ── OS / IDE ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/

# ── Kaggle API key (never commit) ─────────────────────────────
kaggle.json
